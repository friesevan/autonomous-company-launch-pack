{
  "autoUpdatesChannel": "stable",
  "permissions": {
    "allow": [
      "Bash(xcodebuild *)",
      "Bash(xcrun *)",
      "Bash(swift *)",
      "Bash(git *)",
      "Bash(gh *)",
      "Bash(brew *)",
      "Bash(python3 *)",
      "Bash(pip3 *)",
      "Bash(node *)",
      "Bash(npm *)",
      "Bash(jq *)",
      "Bash(launchctl *)",
      "Bash(plutil *)",
      "Bash(mkdir *)",
      "Bash(touch *)",
      "Bash(cp *)",
      "Bash(chmod *)",
      "Bash(tar *)",
      "Bash(zip *)",
      "Bash(unzip *)",
      "Bash(tools/*)",
      "Bash(./tools/*)",
      "Bash(bash tools/*)",
      "WebSearch",
      "WebFetch(domain:apps.apple.com)",
      "WebFetch(domain:developer.apple.com)",
      "WebFetch(domain:support.apple.com)",
      "WebFetch(domain:www.reddit.com)",
      "WebFetch(domain:old.reddit.com)",
      "WebFetch(domain:news.ycombinator.com)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:stackoverflow.com)",
      "WebFetch(domain:code.claude.com)"
    ],
    "deny": [
      "Bash(sudo *)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push * --force)",
      "Bash(git push * -f)",
      "Edit(CLAUDE.md)",
      "Edit(setup/**)",
      "Edit(rules/**)",
      "Edit(investors/allowlist.md)",
      "Edit(.claude/settings.json)",
      "Read(~/.ssh/**)",
      "Read(~/.appstoreconnect/private_keys/**)",
      "Read(ops/secrets.local)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/rules/hooks/protect-records.sh"
          }
        ]
      },
      {
        "matcher": "Agent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/rules/hooks/model-guard.py"
          }
        ]
      }
    ]
  },
  "env": {
    "CLAUDE_CODE_MAX_CONCURRENT_SUBAGENTS": "3",
    "CLAUDE_CODE_MAX_SUBAGENT_SPAWN_DEPTH": "1"
  }
}
